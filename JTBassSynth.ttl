@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<https://github.com/jtemple967/JTBassSynth>
	a lv2:Plugin , lv2:SimulatorPlugin ;
	doap:name "JTBassSynth" ;
	doap:license <http://opensource.org/licenses/GPL-3.0> ;
	doap:maintainer [
		a foaf:Person ;
		foaf:name "Jonas Temple"
	] ;
	doap:homepage <https://github.com/jtemple967/JTBassSynth> ;
	doap:repository [
		a doap:GitRepository ;
		doap:location <https://github.com/jtemple967/JTBassSynth.git> ;
		doap:browse <https://github.com/jtemple967/JTBassSynth>
	] ;
	mod:brand "JT" ;
	mod:label "Bass Synth" ;
	lv2:minorVersion 1 ;
	lv2:microVersion 0 ;
	rdfs:comment "Monophonic pitch-tracking bass synthesizer modeled on MXR-style bass synth pedals: eight voices, resonant ladder filter with envelope sweep, attack swell, glide and independent dry/synth levels." ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:AudioPort , lv2:InputPort ;
		lv2:index 0 ;
		lv2:symbol "in" ;
		lv2:name "In"
	] , [
		a lv2:AudioPort , lv2:OutputPort ;
		lv2:index 1 ;
		lv2:symbol "out" ;
		lv2:name "Out"
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 2 ;
		lv2:symbol "dry" ;
		lv2:name "Dry" ;
		lv2:default 1.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 3 ;
		lv2:symbol "synth" ;
		lv2:name "Synth" ;
		lv2:default 0.7 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 4 ;
		lv2:symbol "voice" ;
		lv2:name "Voice" ;
		lv2:portProperty lv2:integer , lv2:enumeration ;
		lv2:default 2 ;
		lv2:minimum 0 ;
		lv2:maximum 7 ;
		lv2:scalePoint [ rdfs:label "Saw" ;          rdf:value 0 ] ,
		               [ rdfs:label "Square" ;       rdf:value 1 ] ,
		               [ rdfs:label "Saw + Sub" ;    rdf:value 2 ] ,
		               [ rdfs:label "Square + Sub" ; rdf:value 3 ] ,
		               [ rdfs:label "Sub Octave" ;   rdf:value 4 ] ,
		               [ rdfs:label "Octave Up" ;    rdf:value 5 ] ,
		               [ rdfs:label "PWM" ;          rdf:value 6 ] ,
		               [ rdfs:label "Fuzz Square" ;  rdf:value 7 ]
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 5 ;
		lv2:symbol "filter" ;
		lv2:name "Filter" ;
		lv2:portProperty pprops:logarithmic ;
		units:unit units:hz ;
		lv2:default 300.0 ;
		lv2:minimum 40.0 ;
		lv2:maximum 8000.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 6 ;
		lv2:symbol "resonance" ;
		lv2:name "Resonance" ;
		lv2:default 0.45 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 7 ;
		lv2:symbol "attack" ;
		lv2:name "Attack" ;
		lv2:portProperty pprops:logarithmic ;
		units:unit units:ms ;
		lv2:default 5.0 ;
		lv2:minimum 1.0 ;
		lv2:maximum 1500.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 8 ;
		lv2:symbol "decay" ;
		lv2:name "Decay" ;
		lv2:portProperty pprops:logarithmic ;
		units:unit units:ms ;
		lv2:default 350.0 ;
		lv2:minimum 20.0 ;
		lv2:maximum 4000.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 9 ;
		lv2:symbol "env_amount" ;
		lv2:name "Sweep" ;
		lv2:default 0.6 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 10 ;
		lv2:symbol "sensitivity" ;
		lv2:name "Gate Threshold" ;
		units:unit units:db ;
		lv2:default -48.0 ;
		lv2:minimum -80.0 ;
		lv2:maximum -10.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 11 ;
		lv2:symbol "glide" ;
		lv2:name "Glide" ;
		units:unit units:ms ;
		lv2:default 0.0 ;
		lv2:minimum 0.0 ;
		lv2:maximum 500.0
	] .
